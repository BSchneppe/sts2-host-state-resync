<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>SlayTheDivergence</RootNamespace>
    <AssemblyName>SlayTheDivergence</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <!-- Game version the reference assemblies stand in for when no game is installed (CI). The mod patches
         private internals, so this is the version it was written against, not a compatibility range. -->
    <RefAssembliesVersion Condition="'$(RefAssembliesVersion)' == ''">0.111.0-beta-41cef1ea</RefAssembliesVersion>

    <!-- Override with: dotnet build -p:STS2GameDir=... -p:STS2ModsDir=... -->
    <STS2GameDir Condition="'$(STS2GameDir)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDir>
    <STS2ModsDir Condition="'$(STS2ModsDir)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/MacOS/mods</STS2ModsDir>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2/data</STS2GameDir>
    <STS2ModsDir Condition="'$(STS2ModsDir)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2/mods</STS2ModsDir>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2/data</STS2GameDir>
    <STS2ModsDir Condition="'$(STS2ModsDir)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2/mods</STS2ModsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- CI / no game install: reference assemblies from NuGet -->
    <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="$(RefAssembliesVersion)"
                      Condition="!Exists('$(STS2GameDir)/sts2.dll')"
                      PrivateAssets="All" />
  </ItemGroup>

  <!-- Local dev: the real game DLLs -->
  <ItemGroup Condition="Exists('$(STS2GameDir)/sts2.dll')">
    <Reference Include="sts2">
      <HintPath>$(STS2GameDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Keep the tooling projects out of the Godot SDK's auto-globbing -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
  </ItemGroup>

  <Target Name="CopyModFiles" AfterTargets="Build" Condition="Exists('$(STS2ModsDir)')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(STS2ModsDir)/SlayTheDivergence" />
    <Copy SourceFiles="SlayTheDivergence.json" DestinationFolder="$(STS2ModsDir)/SlayTheDivergence" />
  </Target>
</Project>
